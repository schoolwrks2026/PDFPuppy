<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:PdfUtility.App.Helpers">

    <!-- Value Converters -->
    <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <helpers:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />

    <!-- Color Palettes -->
    <!-- Light Theme Palette -->
    <Color x:Key="LightBackgroundColor">#F3F3F3</Color>
    <Color x:Key="LightCardColor">#FFFFFF</Color>
    <Color x:Key="LightPrimaryColor">#0078D4</Color>
    <Color x:Key="LightAccentColor">#107C41</Color>
    <Color x:Key="LightTextColor">#202020</Color>
    <Color x:Key="LightMutedTextColor">#606060</Color>
    <Color x:Key="LightBorderColor">#E0E0E0</Color>

    <!-- Dark Theme Palette -->
    <Color x:Key="DarkBackgroundColor">#202020</Color>
    <Color x:Key="DarkCardColor">#2C2C2C</Color>
    <Color x:Key="DarkPrimaryColor">#60CDFF</Color>
    <Color x:Key="DarkAccentColor">#107C41</Color>
    <Color x:Key="DarkTextColor">#FFFFFF</Color>
    <Color x:Key="DarkMutedTextColor">#A0A0A0</Color>
    <Color x:Key="DarkBorderColor">#404040</Color>

    <!-- Theme Brushes (Bindable) -->
    <!-- Defaulting to modern Light style, dynamically switches with OS theme or user selection -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource LightBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource LightCardColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource LightPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource LightAccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource LightTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource LightMutedTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LightBorderColor}"/>

    <!-- Shared Modern Control Styles -->
    <!-- Modern Button with rounded corners -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Rounded Button -->
    <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded Text Box -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Header / Title Style -->
    <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>

    <!-- Card Container Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

</ResourceDictionary>
