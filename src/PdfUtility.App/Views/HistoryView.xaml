<UserControl x:Class="PdfUtility.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- History Data Grid -->
            <RowDefinition Height="*"/>
            <!-- Action Toolbar bottom -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📜 Operation Audit Log" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="View the history of your offline conversions and merges. Double-click or select actions to open files directly." Style="{StaticResource SubtitleStyle}"/>
        </StackPanel>

        <!-- History Audit Data Grid Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
            <Grid>
                <!-- Empty State Message -->
                <TextBlock Text="Your processing history is empty. Logs will appear here once you process files."
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                           Visibility="{Binding HistoryEntries.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>

                <!-- Log list grid -->
                <ListView x:Name="HistoryGrid" ItemsSource="{Binding HistoryEntries}" BorderThickness="0" Background="Transparent" AlternationCount="2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Action" DisplayMemberBinding="{Binding ActionType}" Width="80"/>
                            <GridViewColumn Header="Source Files" DisplayMemberBinding="{Binding SourceFiles}" Width="220"/>
                            <GridViewColumn Header="Destination Path" DisplayMemberBinding="{Binding OutputPath}" Width="200"/>
                            <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="120"/>
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Action Grid Toolbar Bottom -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="📂 Open Merged/Converted File" Command="{Binding OpenOutputCommand}" CommandParameter="{Binding SelectedItem, ElementName=HistoryGrid}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="📁 Jump to Folder" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=HistoryGrid}" Style="{StaticResource ModernSecondaryButtonStyle}"/>
            </StackPanel>

            <Button Grid.Column="2" Content="🗑️ Clear Log Audit Trail" Command="{Binding ClearHistoryCommand}" Style="{StaticResource ModernSecondaryButtonStyle}"/>
        </Grid>
    </Grid>
</UserControl>
