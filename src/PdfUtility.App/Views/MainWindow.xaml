<Window x:Class="PdfUtility.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:PdfUtility.App.ViewModels"
        xmlns:views="clr-namespace:PdfUtility.App.Views"
        Title="PDF Utility" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Mapping ViewModels to Views using DataTemplates -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ConvertViewModel}">
            <views:ConvertView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MergeViewModel}">
            <views:MergeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SplitViewModel}">
            <views:SplitView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:WatermarkViewModel}">
            <views:WatermarkView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CompressViewModel}">
            <views:CompressView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation Sidebar Column -->
            <ColumnDefinition Width="220"/>
            <!-- Active Page Content Column -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Status Bar Row -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Sidebar Navigation Panel -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header Logo / Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock Text="🐶" FontSize="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PDF Utility" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Offline Companion" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu Links -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="🏠 Dashboard" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10"/>
                        <Button Content="🔄 Convert to PDF" Command="{Binding NavigateToConvertCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                        <Button Content="🥞 Merge PDFs" Command="{Binding NavigateToMergeCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                        <Button Content="✂️ Split PDF" Command="{Binding NavigateToSplitCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                        <Button Content="🏷️ Add Watermark" Command="{Binding NavigateToWatermarkCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                        <Button Content="🗜️ Compress PDF" Command="{Binding NavigateToCompressCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                        <Button Content="📜 History Log" Command="{Binding NavigateToHistoryCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                        <Button Content="⚙️ Settings" Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Theme Toggle Button at Bottom of Sidebar -->
                <Button Grid.Row="2" Content="🌓 Toggle Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10"/>
            </Grid>
        </Border>

        <!-- Main Display Content Area -->
        <Border Grid.Column="1" Grid.Row="0" Padding="32">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>

        <!-- Application Status Bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,4">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="v1.0.0 (Production-Ready)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
