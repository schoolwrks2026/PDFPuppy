<UserControl x:Class="PdfUtility.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Settings Panels -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ App Settings" Style="{StaticResource HeaderTitleStyle}"/>
            <TextBlock Text="Configure your default preferences for offline conversions and document merges." Style="{StaticResource SubtitleStyle}"/>
        </StackPanel>

        <!-- Settings Cards Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Theme Preferences card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🎨 Visual Theme" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose between Light theme, Dark theme, or let the app match your system preference." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="System Default" IsChecked="{Binding Theme, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=System, Mode=TwoWay}" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
                            <RadioButton Content="Light Theme" IsChecked="{Binding Theme, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Light, Mode=TwoWay}" Foreground="{StaticResource TextBrush}" Margin="0,0,16,0"/>
                            <RadioButton Content="Dark Theme" IsChecked="{Binding Theme, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dark, Mode=TwoWay}" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Preferences card -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚙️ Processing Preferences" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                        <!-- Open after completion toggle -->
                        <CheckBox Content="Automatically open PDF documents after completing operations"
                                  IsChecked="{Binding OpenPdfAfterCompletion}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                        <!-- Remember folder toggle -->
                        <CheckBox Content="Remember the last directory selected for output destination"
                                  IsChecked="{Binding RememberLastFolder}"
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

                        <!-- Overwrite files toggle -->
                        <CheckBox Content="Overwrite existing files silently without asking (Default OFF)"
                                  IsChecked="{Binding OverwriteExistingFiles}"
                                  Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Storage defaults card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="📁 Default Saving Destination" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Files will be saved here automatically when no custom output location is specified." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding DefaultOutputFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center"/>
                        <Button Grid.Row="3" Grid.Column="1" Content="Browse Folder" Command="{Binding BrowseFolderCommand}" Style="{StaticResource ModernSecondaryButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
